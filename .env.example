# Telegram: token lấy từ @BotFather
TELEGRAM_BOT_TOKEN=

# Chat/group được phép dùng bot, cách nhau bằng dấu phẩy
# Lấy số này bằng lệnh /id trong chat, hoặc: python check_setup.py
ALLOWED_CHAT_ID=

# (tuỳ chọn) cấp quyền theo username Telegram, cách nhau bằng dấu phẩy
ALLOWED_USERNAMES=

# ── Sổ ───────────────────────────────────────────────
# google = ghi lên Google Sheet | xlsx = ghi file Excel local (KHÔNG dùng trên cloud)
SHEET_BACKEND=google

# Google Sheets
GOOGLE_CREDENTIALS_FILE=credentials/service_account.json
# Trên Render/Vercel: dán NGUYÊN nội dung file JSON vào biến này (1 dòng, đã nén)
GOOGLE_CREDENTIALS_JSON=
# ID nằm giữa /d/ và /edit trong link sheet
SPREADSHEET_ID=
WORKSHEET_NAME=Sheet1

# Chỉ dùng khi SHEET_BACKEND=xlsx
XLSX_PATH=data/soho.xlsx

# ── AI (OpenAI-compatible gateway) ───────────────────
AI_BASE_URL=https://api.hermesgate.app/v1
AI_API_KEY=
AI_MODEL=gemini-3.8-flash-high
AI_TIMEOUT=60

# ── Deploy cloud (Render) ────────────────────────────
# Đặt true để mở /healthz cho health check + pinger chống ngủ
ENABLE_HEALTH_SERVER=false
# Bỏ trống -> dùng polling (mặc định, hợp Render free)
# Set khi có domain HTTPS và muốn webhook: https://your-service.onrender.com
WEBHOOK_URL=
WEBHOOK_SECRET=

# ── Khác ─────────────────────────────────────────────
TIMEZONE=Asia/Ho_Chi_Minh
MAX_ITEMS=20
